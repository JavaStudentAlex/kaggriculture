# Opponent-model data, logs and run artifacts: live on the SSD / ceph, never in git.
# Shards live in datasets/ (ceph) and /results/kagg/datasets (SSD); raw replays are
# Kaggle's daily datasets; the promoted checkpoint lives in models/ and IS committed.
replays/
datasets/
research/opponent_model/logs/
research/opponent_model/runs/

# ShinkaEvolve outputs
shinka_results/
shinka_results.stale_*/
shinka_run.log

# Procedural graph replay dumps and run logs
research/procedural_graph/ladder_losses/*replay.json
research/procedural_graph/**/*.log
research/procedural_graph/*.log

# Shinka run mirrors (SSD -> ceph copies of /results/kagg/shinka_results*), the evaluator's
# game log, built submission bundles and the checkpoint copy (byte copy of models/*)
shinka_results*/
shinka/champions/pool/games.jsonl
shinka/champions/submissions/*.tar.gz
shinka/evolution/checkpoint/
